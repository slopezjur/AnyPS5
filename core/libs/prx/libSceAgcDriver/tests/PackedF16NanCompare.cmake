foreach(required IN ITEMS FIXTURE OUTPUT_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef runId)
set(runDirectory "${OUTPUT_ROOT}/packed-f16-nan-${runId}")
file(MAKE_DIRECTORY "${runDirectory}")
set(branchSettings --unset=APS5_NO_PACKED_F16_NAN_BRANCH)
set(selectsSettings APS5_NO_PACKED_F16_NAN_BRANCH=1)
foreach(name IN ITEMS branch selects)
    execute_process(
            COMMAND "${CMAKE_COMMAND}" -E env ${${name}Settings} "ANYPS5_NO_SHADER_CACHE=1" "${FIXTURE}" "${runDirectory}/${name}.bin"
            WORKING_DIRECTORY "${runDirectory}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120
    )
    file(WRITE "${runDirectory}/${name}.log" "${output}\n${error}")
    if(result STREQUAL "77" AND NOT DEFINED ENV{ANYPS5_REQUIRE_VULKAN})
        message(STATUS "packed f16 NaN compare: skipped, no usable Vulkan device")
        file(REMOVE_RECURSE "${runDirectory}")
        return()
    endif()
    if(NOT result STREQUAL "0" OR NOT output MATCHES "packed f16 NaN results written")
        message(FATAL_ERROR "packed f16 NaN run ${name} failed: ${result}\n${output}\n${error}")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${runDirectory}/branch.bin" "${runDirectory}/selects.bin" RESULT_VARIABLE different)
if(NOT different STREQUAL "0")
    message(FATAL_ERROR "packed f16 NaN compare: the NaN branch differs from the lane selects; outputs kept in ${runDirectory}")
endif()
file(REMOVE_RECURSE "${runDirectory}")
message(STATUS "packed f16 NaN compare passed")
