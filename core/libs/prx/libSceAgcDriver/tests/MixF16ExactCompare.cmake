foreach(required IN ITEMS FIXTURE OUTPUT_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef runId)
set(runDirectory "${OUTPUT_ROOT}/mix-f16-exact-${runId}")
file(MAKE_DIRECTORY "${runDirectory}")
set(tieSettings --unset=APS5_NO_MIX_TIE_FAST --unset=APS5_NO_MIX_F32)
set(two_sumSettings --unset=APS5_NO_MIX_F32 APS5_NO_MIX_TIE_FAST=1)
set(f64Settings --unset=APS5_NO_MIX_TIE_FAST APS5_NO_MIX_F32=1)
foreach(name IN ITEMS tie two_sum f64)
    execute_process(
            COMMAND "${CMAKE_COMMAND}" -E env ${${name}Settings} "ANYPS5_NO_SHADER_CACHE=1" "${FIXTURE}" "${runDirectory}/${name}.bin"
            WORKING_DIRECTORY "${runDirectory}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120
    )
    file(WRITE "${runDirectory}/${name}.log" "${output}\n${error}")
    if(result STREQUAL "77" AND NOT DEFINED ENV{ANYPS5_REQUIRE_VULKAN})
        message(STATUS "mix f16 exact compare: skipped, no usable Vulkan device")
        file(REMOVE_RECURSE "${runDirectory}")
        return()
    endif()
    if(NOT result STREQUAL "0" OR NOT output MATCHES "MIX words=")
        message(FATAL_ERROR "mix f16 exact run ${name} failed: ${result}\n${output}\n${error}")
    endif()
endforeach()
foreach(name IN ITEMS two_sum f64)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${runDirectory}/tie.bin" "${runDirectory}/${name}.bin" RESULT_VARIABLE different)
    if(NOT different STREQUAL "0")
        message(FATAL_ERROR "mix f16 exact compare: the fused tie path differs from the ${name} path; outputs kept in ${runDirectory}")
    endif()
endforeach()
file(REMOVE_RECURSE "${runDirectory}")
message(STATUS "mix f16 exact compare passed")
